<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="hirrus_runway">
    <!-- Fast-time-capable physics, reused from zephyr_runway.sdf: SIM_SPEEDUP
         in ArduPilot can push past real time. -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>-1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <!-- Required for hirrus/model.sdf's manually-fired catapult launch
         (see that file's own "Catapult launch" comment) -- this plugin
         must be declared per-world, not per-model, confirmed live
         ("ApplyLinkWrench system should be attached to a world"). Any
         world flying this model needs this too. -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"></plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <!-- CMAC (ArduPilot's own default SITL location), same as zephyr_runway.sdf. -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://runway</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <!-- Launch ramp on the runway surface (world Z=0): zero friction so
         the catapult's one-shot forward impulse (model.sdf's own
         ApplyLinkWrench comment) isn't fighting the runway plane's own
         default ODE friction -- there's no landing gear, the plane's
         belly slides directly on whatever it's resting on. See
         models/launch_ramp's own comment. -->
    <include>
      <uri>model://launch_ramp</uri>
      <pose degrees="true">0 0 0 0 0 0</pose>
    </include>

    <!-- Hirrus, resting on the ramp above, flat (not vertical like
         Zephyr's tail-sitter takeoff). Z=0.83: ramp top (2m thick --
         see launch_ramp/model.sdf's own comment for why, not the more
         obvious-looking 0.3m -- centered at 0 -> top at 1.0) plus
         base_link_collision's own bottom offset (-0.196 from an include
         pose of 0, see Domnesti-Slanic-5.world's matching spawn-pose
         comment for the full arithmetic) plus a 3cm clearance, same
         derivation as there just with this world's ramp centered at
         Z=0 instead of 15 (so ~1m of the ramp's own 2m thickness sits
         below the runway plane -- harmless, nothing renders/collides
         from below it anyway). -->
    <include>
      <uri>model://hirrus</uri>
      <pose degrees="true">0 0 0.83 0 0 0</pose>
    </include>
  </world>
</sdf>
