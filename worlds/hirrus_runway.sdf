<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="hirrus_runway">
    <!-- Fast-time-capable physics, reused from zephyr_runway.sdf: SIM_SPEEDUP
         in ArduPilot can push past real time. -->

    <model name="safety_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10000 10000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0</mu>
                <mu2>0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
      <!-- Reverted from a tilted launch-ramp coincident with the runway
           (caused hirrus to sink -- two ground planes almost overlapping
           at the exact same X/Y/Z, contact resolution between them was
           undefined) back to its original AeroCanyon_Guard-derived role:
           a flat, low, collision-only catch net well clear of the
           runway's own z=0 plane, purely to stop the vehicle from
           falling forever if it ever slips through a gap. Not meant to
           be landed/launched on -- that's the runway's own job now. -->
      <pose>0 0 -20 0 0 0</pose>
    </model>

    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>-1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">      
		<render_engine>ogre2</render_engine>
    </plugin>	
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"></plugin>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed" />
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_threshold>0.001</force_approximation_threshold>
      <default_wind><linear>0.0 0.0 0.0</linear></default_wind>
    </plugin>	

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <!-- Domnesti-Slanic-5's own real-world coordinates (not CMAC/Zephyr's
         default) -- matches README.md's sim_vehicle.py --custom-location
         exactly (checked: lat/lon/elevation agree). heading_deg=0 here is
         the world's own north reference for lat/lon math, independent of
         the runway model's own yaw=363deg placement below -- the two
         don't need to match. -->
    <spherical_coordinates>
      <latitude_deg>44.39361401276187</latitude_deg> 
      <longitude_deg>25.941499548422655</longitude_deg>
      <elevation>85.2</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://runway</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <!-- Webview-only textured overlay for the runway's zebra/number
         markings -- see runway_markings/model.sdf's own comment for why
         model://runway's real markings (an SDF <pbr> plane) never show up
         in the browser viewer. Same world pose as model://runway itself;
         its own local pose (0 0 0.02, yaw 90deg) reproduces that model's
         "runway" visual's local plane pose on top of it. -->
    <include>
      <uri>model://runway_markings</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <!-- Hirrus, at one end of the runway strip, longitudinal axis aligned
         with it. Real heading = 93deg, NOT the include's own 363deg --
         model://runway's VISUAL strip carries its own extra local
         <pose>0 0 0 0 0 90</pose> on top of the include yaw (the
         collision itself is an unbounded plane with no size at all, only
         the visual is the 1500x100 strip) -- missed that the first two
         times, which is why nothing lined up. Strip center is the
         include position (-29,545); half-length 750m along heading 93deg
         puts the two ends at roughly (7.6,-154.0) and (-65.6,1244.0) --
         placed at the first, nose pointed at the second (yaw=93,
         inboard by 50m of the true end for margin). Z=-0.166: same
         resting-flush arithmetic as before (base_link_collision's own
         bottom sits at model_z+0.196, solved against the runway's flat
         z=0 collision plane with a 3cm clearance) -- unaffected by the
         heading fix, only X/Y/yaw changed. -->
    <include>
      <uri>model://hirrus</uri>
      <!-- Z=0.24. Every prior version of this comment (0.196, 0.036 above
         model origin, etc.) double-counted model.sdf's own top-level
         <pose>0 0 0.246 0 0 0</pose> lift -- confirmed empirically
         (dropped hirrus from Z=2 in an isolated test and watched it
         settle) that gz's own reported/settable "hirrus" pose ALREADY
         includes that lift; it is NOT a separate model-root frame you
         then add 0.246 to. Real relationship, ground-truthed:
         model_z + wheel_local_bottom_z = world_ground_z. Wheel bottoms
         sit at local z=-0.21 relative to base_link (axle -0.15/-0.16,
         radius 0.06/0.05) -- solving model_z + (-0.21) = 0 (runway) +
         0.03 (clearance) gives model_z = 0.24. Empirically confirmed
         settle point (no clearance) was Z=0.21, consistent with this. -->
      <pose degrees="true">7.635 -154.041 0.24 0 0 93</pose>
    </include>
  </world>
</sdf>
