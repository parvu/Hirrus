<?xml version="1.0"?>

<model>
  <name>Runway Markings (webview overlay)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    A textured quad duplicating model://runway's zebra-stripe/number
    markings, laid on top of that model's own PBR-textured plane. Exists
    only because the browser viewer's bundled three.js ColladaLoader has
    no PBR material support, so those markings never rendered there -- see
    this model's model.sdf for the full explanation. gz sim's own render
    is unaffected; this is purely additive.
  </description>
</model>
