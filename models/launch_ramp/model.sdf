<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="launch_ramp">
    <static>true</static>
    <link name="ramp">
      <!-- 2m(X) x 4m(Y): X covers the fuselage's own ~1.18m collision
           length with margin, Y covers the full ~3.28m wingspan
           (base_link_collision's own silhouette box is that wide) so a
           wingtip doesn't hang off the edge.

           2m(Z) THICK -- confirmed live this isn't optional: on a world
           using the "bullet" DART collision detector (needed elsewhere
           for heightmap terrain, see Domnesti-Slanic-5.world's own
           <physics> comment), hirrus's own base_link_collision box
           (1.18 x 3.28 x 0.06) fell straight through this ramp at 0.3m
           thick every time -- no contact, no bounce, straight through,
           reproduced in an isolated test world with nothing else in it.
           Thickening the FALLING box (tried 0.2m, then 0.5m, matching
           the ramp's own working 0.5x0.5x0.5 test cube) did NOT fix it --
           it's specifically the STATIC ramp's own thinness bullet
           struggles with here, not the dynamic box's. A 2m-thick ramp
           caught it cleanly and it settled rock-stable. Not investigated
           further than "thick enough works" -- if this needs
           slimming down later, retest against this exact repro before
           assuming a thinner value is safe. -->
      <collision name="ramp_collision">
        <geometry>
          <box>
            <size>2 4 2</size>
          </box>
        </geometry>
        <surface>
          <!-- The whole point: zero this side's friction so the combined
               contact friction is zero regardless of what the plane's own
               belly collision (base_link_collision, default/unset
               friction) contributes. -->
          <friction>
            <ode>
              <mu>0</mu>
              <mu2>0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="ramp_visual">
        <geometry>
          <box>
            <size>2 4 2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.32 1</ambient>
          <diffuse>0.35 0.35 0.38 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
