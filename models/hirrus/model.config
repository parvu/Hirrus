<?xml version="1.0"?>

<model>
  <name>Hirrus</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    Plain fixed-wing Hirrus flying wing (pusher prop + 2 elevons), for
    ArduPlane SITL over gz-sim. Geometry/mesh and aero data forked from
    this same airframe's tricopter VTOL variant in
    ~/AeroCanyon_Guard/src/aerocanyon/models/tricopter_ap/ (all tilt-rotor
    machinery removed, single fixed pusher prop added, modeled after
    ~/ardupilot_gazebo/models/zephyr). Mass, inertia, CG and the wing's
    real CL-alpha/drag polar come from Hirrus.avl's own AVL run
    (Polara.txt, Type-7 stability analysis with a loaded mass file) --
    see model.sdf's own comments for the derivation.
  </description>
</model>
