<?xml version='1.0'?>
<gz version='1.0'>

  <!-- Ported from AeroCanyon_Guard/web_viewer/websocket.gzlaunch: bridges
       the ALREADY-RUNNING gz-transport session started by run_sitl.sh via
       `gz launch -f websocket.gzlaunch`. No separate sim launch here. -->
  <plugin name="gz::launch::WebsocketServer"
          filename="gz-launch-websocket-server">
    <publication_hz>30</publication_hz>
    <port>9002</port>
    <max_connections>-1</max_connections>
    <!-- With none configured, WebsocketServer.cc still authorizes every
         connection but never sends the "authorized" ack the client is
         waiting for, so the handshake stalls forever. Matches index.html's
         key below. Trivial/shared, fine for a local dev viewer only
         reachable on localhost. -->
    <authorization_key>hirrus_dev</authorization_key>
  </plugin>

</gz>
