# ArduPlane default params for the Hirrus flying wing over gz-sim.
# Modeled on ~/ardupilot/Tools/autotest/default_params/gazebo-zephyr.parm --
# same elevon-only SERVO wiring, same INS calibration workaround, same
# ARSPD_TYPE=0 (no airspeed sensor modeled -- worlds/hirrus_runway.sdf has
# no "airspeed" model include, unlike tricopter_ap's ROS2 workspace).
#
# Loaded via `sim_vehicle.py --add-param-file=hirrus.parm` (see run_sitl.sh)
# rather than registering a "gazebo-hirrus" frame in the shared ~/ardupilot
# checkout's Tools/autotest/pysim/vehicleinfo.json -- same effect, without
# editing a repo other projects (AeroCanyon_Guard) also depend on.

SERVO1_FUNCTION 77
SERVO2_FUNCTION 78
SERVO1_REVERSED 0
SERVO2_REVERSED 0
SERVO3_FUNCTION 70

# we need small INS_ACC offsets so INS is recognised as being calibrated
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X  0.001
INS_ACC2OFFS_Y  0.001
INS_ACC2OFFS_Z  0.001
INS_ACC2SCAL_X  1.001
INS_ACC2SCAL_Y  1.001
INS_ACC2SCAL_Z  1.001
INS_GYR_CAL     0

ARSPD_TYPE      0
BATT_MONITOR    4

# Catapult/hand-launch detection (ArduPlane/Parameters.cpp, real params --
# verified against source, not the fabricated SIM_PLT_LAUNCH_A/T some AI
# summaries invent). This is pure accelerometer-threshold logic in
# ArduPilot's own flight code -- it works the same regardless of physics
# backend, unlike ArduPilot's SEPARATE internal SIM_Plane.cpp catapult
# force simulation (SIM_Plane's own "-catapult"/"-bungee" frame strings),
# which only runs for --model plane, NOT our --model JSON/gz-sim setup.
# The actual forward force here comes from gz-sim (worlds/hirrus_runway.sdf's
# safety_floor launch slope, or hirrus's own manually-fired ApplyLinkWrench
# impulse, see model.sdf's "Catapult launch" comment) -- these params just
# tell ArduPilot when to trust that a real launch happened and open the
# throttle, same as a real catapult/hand-launch airframe.
TKOFF_THR_MINACC 15
TKOFF_ACCEL_CNT  1
TKOFF_THR_DELAY  2
# Recommended for hand/catapult launch (ArduPlane/Parameters.cpp's own
# TKOFF_TDRAG_SPD1/TKOFF_ROTATE_SPD descriptions): zero means skip the
# ground-roll "tail hold"/rotate-speed staging that only makes sense for
# a wheeled takeoff run.
TKOFF_TDRAG_SPD1 0
TKOFF_ROTATE_SPD 0
