# web_viewer/assets/runway is a symlink to the runway model in the
# separate ardupilot_gazebo checkout ($HOME/ardupilot_gazebo/models/runway,
# per this project's own README prerequisites) -- machine-specific, can't
# be committed portably. Recreate it after cloning:
#   ln -s $HOME/ardupilot_gazebo/models/runway web_viewer/assets/runway
/web_viewer/assets/runway

__pycache__/
*.pyc

# ArduPilot SITL working-directory scratch state, created wherever
# arduplane happens to be run from.
eeprom.bin
mav.tlog
mav.tlog.raw
mav.parm
logs/
terrain/
